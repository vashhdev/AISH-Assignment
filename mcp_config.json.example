{
  "_comment": "Copy to mcp_config.json (gitignored) and fill in the paths. Without mcp_config.json the pipeline uses this same server with the default ~/.gmail-mcp/ paths. The OAuth client keys and the token file stay outside the repo.",
  "mcpServers": {
    "gmail": {
      "command": "npx",
      "args": ["-y", "@gongrzhe/server-gmail-autoauth-mcp@1.1.11"],
      "env": {
        "GMAIL_OAUTH_PATH": "/absolute/path/to/.gmail-mcp/gcp-oauth.keys.json",
        "GMAIL_CREDENTIALS_PATH": "/absolute/path/to/.gmail-mcp/credentials.json"
      }
    }
  }
}
